title                   = NPT equilibration
integrator              = md
dt                      = 0.002
nsteps                  = 50000
continuation            = yes
constraints             = h-bonds
constraint-algorithm    = lincs
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
coulombtype             = PME
rcoulomb                = 1.2
vdwtype                 = Cut-off
rvdw                    = 1.2
rvdw-switch             = 1.0
vdw-modifier            = force-switch
DispCorr                = no
tcoupl                  = V-rescale
tc-grps                 = Protein_LIG Water_and_ions
tau_t                   = 0.1 0.1
ref_t                   = 300 300
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5
pbc                     = xyz
gen_vel                 = no
define                  = -DPOSRES -DPOSRES_LIGAND
nstxout-compressed      = 500
nstenergy               = 500
nstlog                  = 500
refcoord_scaling        = com
