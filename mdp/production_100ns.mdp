title                   = 100 ns conventional unbiased production MD
integrator              = md
dt                      = 0.002
nsteps                  = @NSTEPS@
continuation            = no
constraints             = h-bonds
constraint-algorithm    = lincs
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
coulombtype             = PME
rcoulomb                = 1.2
vdwtype                 = Cut-off
rvdw                    = 1.2
rvdw-switch             = 1.0
vdw-modifier            = force-switch
DispCorr                = no
tcoupl                  = V-rescale
tc-grps                 = Protein_LIG Water_and_ions
tau_t                   = 0.1 0.1
ref_t                   = 300 300
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 5.0
ref_p                   = 1.0
compressibility         = 4.5e-5
pbc                     = xyz
gen_vel                 = yes
gen_temp                = 300
gen_seed                = -1
define                  =
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstxout-compressed       = @XTCSTRIDE@
nstenergy                = 5000
nstlog                   = 5000
